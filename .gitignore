# ── Python 编译缓存 ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python

# ── 测试 / 类型检查缓存 ────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── 模型权重缓存（BiRefNet / rembg 等运行时下载）─────
.models/
*.onnx
*.pth
*.bin
!**/models/**  # 保留代码内模型定义目录

# ── 敏感信息 / API 密钥（绝不入库）─────────────────────
.env
.env.*
!.env.example
*.secret
*_api_key*
*_token*
credentials.json
secrets.json

# ── 生成产物（处理后的图片）────────────────────────────
output/
*.png.tmp

# ── 开发软件配置目录 / IDE ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── 操作系统产生的文件 ─────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE_BIN/
ehthumbs.db

# ── 日志 / 临时文件 ────────────────────────────────────
*.log
.tmp/
tmp/
